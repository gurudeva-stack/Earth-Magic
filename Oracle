<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Earth Magic Oracle | Oráculo de la Tierra</title>
  
  <!-- Google Fonts: Cinzel Decorative, Cormorant Garamond, Montserrat -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --bg-dark: #080d09;
      --bg-card: #111a13;
      --bg-card-hover: #18261c;
      --primary-gold: #e2c070;
      --gold-glow: rgba(226, 192, 112, 0.3);
      --gold-dark: #9e7f33;
      --forest-green: #223829;
      --emerald-accent: #3d6346;
      --text-light: #ece3d2;
      --text-muted: #a1b0a3;
      --terracotta: #c46d4e;
      --shadow-mystic: 0 10px 30px rgba(0, 0, 0, 0.7);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-light);
      font-family: 'Cormorant Garamond', serif;
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    /* Ambient particles container */
    #particles-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .firefly {
      position: absolute;
      width: 4px;
      height: 4px;
      background: var(--primary-gold);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--primary-gold);
      opacity: 0;
      animation: floatFirefly 12s infinite ease-in-out;
    }

    @keyframes floatFirefly {
      0% { transform: translateY(100vh) translateX(0) scale(0.5); opacity: 0; }
      20% { opacity: 0.8; }
      80% { opacity: 0.8; }
      100% { transform: translateY(-10vh) translateX(100px) scale(1.2); opacity: 0; }
    }

    /* Layout */
    header {
      text-align: center;
      padding: 3rem 1rem 1.5rem;
      position: relative;
      z-index: 10;
    }

    .brand-title {
      font-family: 'Cinzel Decorative', cursive;
      font-size: clamp(2rem, 5vw, 3.5rem);
      color: var(--primary-gold);
      text-shadow: 0 0 15px var(--gold-glow);
      letter-spacing: 2px;
      margin-bottom: 0.5rem;
    }

    .brand-subtitle {
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(0.85rem, 2vw, 1.05rem);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 4px;
      font-weight: 300;
    }

    /* Navigation Tabs */
    .nav-tabs {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin: 2rem 0;
      position: relative;
      z-index: 10;
      flex-wrap: wrap;
    }

    .tab-btn {
      background: transparent;
      border: 1px solid rgba(226, 192, 112, 0.2);
      color: var(--text-muted);
      padding: 0.6rem 1.4rem;
      border-radius: 30px;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.85rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .tab-btn:hover, .tab-btn.active {
      color: var(--primary-gold);
      border-color: var(--primary-gold);
      background: rgba(226, 192, 112, 0.08);
      box-shadow: 0 0 15px var(--gold-glow);
    }

    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
      position: relative;
      z-index: 10;
    }

    /* Views container */
    .view-content {
      display: none;
    }

    .view-content.active {
      display: block;
      animation: fadeIn 0.5s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Controls Bar */
    .controls-bar {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }

    .mode-btn {
      background: var(--bg-card);
      border: 1px solid var(--emerald-accent);
      color: var(--text-light);
      padding: 0.7rem 1.5rem;
      border-radius: 8px;
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .mode-btn.active {
      background: var(--forest-green);
      border-color: var(--primary-gold);
      color: var(--primary-gold);
    }

    .draw-btn {
      background: linear-gradient(135deg, var(--gold-dark), var(--primary-gold));
      color: var(--bg-dark);
      border: none;
      padding: 0.8rem 2.2rem;
      border-radius: 30px;
      font-family: 'Montserrat', sans-serif;
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 4px 20px var(--gold-glow);
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .draw-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 25px rgba(226, 192, 112, 0.5);
    }

    .draw-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    /* Oracle Table Area */
    .oracle-table {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 2rem;
      flex-wrap: wrap;
      min-height: 480px;
      margin-top: 1rem;
    }

    /* Card Component 3D */
    .card-slot {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 260px;
    }

    .slot-label {
      font-family: 'Montserrat', sans-serif;
      font-size: 0.85rem;
      color: var(--primary-gold);
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 1rem;
      height: 24px;
    }

    .card-container {
      width: 260px;
      height: 420px;
      perspective: 1000px;
      cursor: pointer;
    }

    .card-inner {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      border-radius: 16px;
      box-shadow: var(--shadow-mystic);
    }

    .card-container.flipped .card-inner {
      transform: rotateY(180deg);
    }

    .card-face {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      border-radius: 16px;
      border: 2px solid var(--primary-gold);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* Card Back Design */
    .card-back {
      background: radial-gradient(circle, var(--forest-green) 0%, var(--bg-dark) 100%);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 12px;
    }

    .card-back-pattern {
      width: 100%;
      height: 100%;
      border: 1px solid rgba(226, 192, 112, 0.4);
      border-radius: 10px;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      background: repeating-linear-gradient(
        45deg,
        rgba(226, 192, 112, 0.03),
        rgba(226, 192, 112, 0.03) 10px,
        transparent 10px,
        transparent 20px
      );
    }

    .card-back-symbol {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      border: 1px solid var(--primary-gold);
      display: flex;
      justify-content: center;
      align-items: center;
      color: var(--primary-gold);
      box-shadow: 0 0 20px var(--gold-glow);
    }

    /* Card Front Design */
    .card-front {
      background: var(--bg-card);
      transform: rotateY(180deg);
      padding: 1.2rem;
      justify-content: space-between;
      align-items: center;
      text-align: center;
    }

    .card-header-art {
      width: 100%;
      height: 180px;
      border-radius: 8px;
      background-size: cover;
      background-position: center;
      border: 1px solid rgba(226, 192, 112, 0.3);
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .card-element-icon {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(8, 13, 9, 0.8);
      border: 1px solid var(--primary-gold);
      border-radius: 50%;
      width: 30px;
      height: 30px;
      display: flex;
      justify-content: center;
      align-items: center;
      color: var(--primary-gold);
    }

    .card-number {
      font-family: 'Montserrat', sans-serif;
      font-size: 0.75rem;
      color: var(--text-muted);
      letter-spacing: 2px;
      margin-top: 0.4rem;
    }

    .card-title {
      font-family: 'Cinzel Decorative', cursive;
      font-size: 1.15rem;
      color: var(--primary-gold);
      margin: 0.2rem 0;
    }

    .card-keywords {
      font-family: 'Montserrat', sans-serif;
      font-size: 0.75rem;
      color: var(--terracotta);
      font-weight: 500;
      letter-spacing: 1px;
      margin-bottom: 0.5rem;
    }

    .card-description {
      font-size: 0.92rem;
      line-height: 1.35;
      color: var(--text-light);
      overflow-y: auto;
      max-height: 100px;
      padding-right: 4px;
    }

    .card-description::-webkit-scrollbar {
      width: 3px;
    }
    .card-description::-webkit-scrollbar-thumb {
      background: var(--gold-dark);
      border-radius: 3px;
    }

    /* Compendium View */
    .compendium-search {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .search-input-wrapper {
      position: relative;
      flex: 1;
      min-width: 250px;
    }

    .search-input-wrapper i {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
    }

    .search-input {
      width: 100%;
      padding: 0.75rem 1rem 0.75rem 2.8rem;
      background: var(--bg-card);
      border: 1px solid rgba(226, 192, 112, 0.3);
      border-radius: 8px;
      color: var(--text-light);
      font-family: 'Montserrat', sans-serif;
      font-size: 0.9rem;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--primary-gold);
      box-shadow: 0 0 10px var(--gold-glow);
    }

    .element-filters {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .filter-btn {
      background: var(--bg-card);
      border: 1px solid rgba(226, 192, 112, 0.2);
      color: var(--text-muted);
      padding: 0.5rem 1rem;
      border-radius: 20px;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .filter-btn.active, .filter-btn:hover {
      background: var(--forest-green);
      color: var(--primary-gold);
      border-color: var(--primary-gold);
    }

    .compendium-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.5rem;
    }

    .compendium-item {
      background: var(--bg-card);
      border: 1px solid rgba(226, 192, 112, 0.2);
      border-radius: 12px;
      padding: 1rem;
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .compendium-item:hover {
      transform: translateY(-4px);
      border-color: var(--primary-gold);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
    }

    .compendium-thumb {
      height: 140px;
      border-radius: 8px;
      background-size: cover;
      background-position: center;
      margin-bottom: 0.8rem;
      position: relative;
    }

    .compendium-title {
      font-family: 'Cinzel Decorative', cursive;
      font-size: 1rem;
      color: var(--primary-gold);
      margin-bottom: 0.2rem;
    }

    .compendium-element {
      font-family: 'Montserrat', sans-serif;
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    /* Reading History */
    .history-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .history-card {
      background: var(--bg-card);
      border: 1px solid rgba(226, 192, 112, 0.2);
      border-radius: 12px;
      padding: 1.5rem;
    }

    .history-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(226, 192, 112, 0.1);
      padding-bottom: 0.8rem;
      margin-bottom: 1rem;
    }

    .history-date {
      font-family: 'Montserrat', sans-serif;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .history-type {
      font-family: 'Cinzel Decorative', cursive;
      color: var(--primary-gold);
    }

    .history-cards-flex {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }

    .history-card-mini {
      min-width: 140px;
      background: rgba(0,0,0,0.3);
      padding: 0.8rem;
      border-radius: 8px;
      border: 1px solid rgba(226, 192, 112, 0.2);
      text-align: center;
    }

    /* Modal Details */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(5px);
      z-index: 100;
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-content {
      background: var(--bg-card);
      border: 2px solid var(--primary-gold);
      border-radius: 16px;
      max-width: 500px;
      width: 90%;
      max-height: 85vh;
      overflow-y: auto;
      padding: 2rem;
      position: relative;
      box-shadow: 0 0 30px var(--gold-glow);
    }

    .modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.5rem;
      cursor: pointer;
    }

    .modal-close:hover {
      color: var(--primary-gold);
    }

    /* Footer */
    footer {
      text-align: center;
      padding: 2rem;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.8rem;
      color: var(--text-muted);
      border-top: 1px solid rgba(226, 192, 112, 0.1);
      position: relative;
      z-index: 10;
    }

    @media (max-width: 768px) {
      .oracle-table {
        flex-direction: column;
        align-items: center;
      }
      .card-container {
        width: 240px;
        height: 390px;
      }
    }
  </style>
</head>
<body>

  <div id="particles-container"></div>

  <header>
    <h1 class="brand-title">Earth Magic Oracle</h1>
    <p class="brand-subtitle">Sabiduría ancestral de la Madre Tierra</p>
  </header>

  <nav class="nav-tabs">
    <button class="tab-btn active" data-tab="reading">
      <i data-lucide="sparkles"></i> Lectura
    </button>
    <button class="tab-btn" data-tab="compendium">
      <i data-lucide="book-open"></i> Galería (50 Cartas)
