        <button class="mode-btn" data-mode="3">Tirada de 3 Cartas</button>
        <button id="draw-cards-btn" class="draw-btn">
          <i data-lucide="wand-2"></i> Mezclar y Extraer
        </button>
      </div>

      <div id="oracle-table" class="oracle-table">
        <!-- Las cartas se generan dinámicamente -->
      </div>
    </section>

    <!-- VISTA 2: GALERÍA/COMPENDIO -->
    <section id="compendium-view" class="view-content">
      <div class="compendium-search">
        <div class="search-input-wrapper">
          <i data-lucide="search"></i>
          <input type="text" id="search-card" class="search-input" placeholder="Buscar por nombre o palabra clave...">
        </div>
        <div class="element-filters">
          <button class="filter-btn active" data-filter="all">Todas</button>
          <button class="filter-btn" data-filter="Tierra">Tierra</button>
          <button class="filter-btn" data-filter="Agua">Agua</button>
          <button class="filter-btn" data-filter="Aire">Aire</button>
          <button class="filter-btn" data-filter="Fuego">Fuego</button>
          <button class="filter-btn" data-filter="Espíritu">Espíritu</button>
        </div>
      </div>

      <div id="compendium-grid" class="compendium-grid">
        <!-- Generado dinámicamente -->
      </div>
    </section>

    <!-- VISTA 3: HISTORIAL -->
    <section id="history-view" class="view-content">
      <div id="history-list" class="history-list">
        <!-- Generado dinámicamente -->
      </div>
    </section>
  </main>

  <!-- MODAL DE DETALLE -->
  <div id="card-modal" class="modal-overlay">
    <div class="modal-content">
      <button class="modal-close" id="modal-close-btn">&times;</button>
      <div id="modal-body">
        <!-- Contenido dinámico -->
      </div>
    </div>
  </div>

  <footer>
    <p>Earth Magic Oracle &copy; 2026. Conéctate con la guía espiritual de los elementos.</p>
  </footer>

  <script>
