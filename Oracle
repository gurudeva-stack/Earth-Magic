    // Iconos de Elementos (SVG Lucide)
    const ELEMENT_ICONS = {
      Tierra: 'mountain',
      Agua: 'droplets',
      Aire: 'wind',
      Fuego: 'flame',
      Espíritu: 'sparkles'
    };

    /* ===================================================
       2. ESTADO DE LA APLICACIÓN
       =================================================== */
    let currentMode = 1; // 1 o 3 cartas
    let currentReading = [];
    let history = [];

    /* ===================================================
       3. INICIALIZACIÓN Y EVENTOS
       =================================================== */
    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();
      createParticles();
      setupTabs();
      setupReadingControls();
      renderOracleSlots();
      renderCompendium(CARDS);
      setupCompendiumFilters();
      setupModal();
    });

    // Crear partículas flotantes
    function createParticles() {
      const container = document.getElementById("particles-container");
      for (let i = 0; i < 25; i++) {
        const firefly = document.createElement("div");
        firefly.className = "firefly";
        firefly.style.left = `${Math.random() * 100}vw`;
        firefly.style.animationDelay = `${Math.random() * 10}s`;
        firefly.style.animationDuration = `${8 + Math.random() * 8}s`;
        container.appendChild(firefly);
      }
    }

    // Pestañas principales
    function setupTabs() {
      const tabBtns = document.querySelectorAll(".tab-btn");
      const views = document.querySelectorAll(".view-content");

      tabBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          tabBtns.forEach(b => b.classList.remove("active"));
          views.forEach(v => v.classList.remove("active"));

          btn.classList.add("active");
          const target = btn.dataset.tab;
          document.getElementById(`${target}-view`).classList.add("active");
        });
      });
    }

    /* ===================================================
       4. LÓGICA DE LECTURA DE CARTAS
       =================================================== */
    function setupReadingControls() {
      const modeBtns = document.querySelectorAll(".mode-btn");
      const drawBtn = document.getElementById("draw-cards-btn");

      modeBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          modeBtns.forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          currentMode = parseInt(btn.dataset.mode);
          renderOracleSlots();
        });
      });

      drawBtn.addEventListener("click", performReading);
    }

    function renderOracleSlots() {
      const table = document.getElementById("oracle-table");
      table.innerHTML = "";

      const labels = currentMode === 1 
        ? ["Orientación Espiritual"] 
        : ["Semilla (Origen)", "Brote (Presente)", "Florecimiento (Futuro)"];

      for (let i = 0; i < currentMode; i++) {
        const slot = document.createElement("div");
        slot.className = "card-slot";
        slot.innerHTML = `
          <div class="slot-label">${labels[i]}</div>
          <div class="card-container" id="slot-${i}" onclick="flipSingleCard(${i})">
            <div class="card-inner">
              <div class="card-face card-back">
                <div class="card-back-pattern">
                  <div class="card-back-symbol">
                    <i data-lucide="trees" style="width:36px; height:36px;"></i>
                  </div>
                </div>
              </div>
              <div class="card-face card-front" id="card-front-${i}">
                <!-- Contenido de la carta cargado tras la tirada -->
              </div>
            </div>
          </div>
        `;
        table.appendChild(slot);
      }
      lucide.createIcons();
    }

    // LÓGICA ALEATORIA DE EXTRACCIÓN (Math.random)
    function performReading() {
      const drawBtn = document.getElementById("draw-cards-btn");
      drawBtn.disabled = true;

      // Resetear volteo
      const containers = document.querySelectorAll(".card-container");
      containers.forEach(c => c.classList.remove("flipped"));

      setTimeout(() => {
        // Seleccionar cartas al azar sin repetir
        let available = [...CARDS];
        currentReading = [];

        for (let i = 0; i < currentMode; i++) {
          const randomIndex = Math.floor(Math.random() * available.length);
          const selectedCard = available.splice(randomIndex, 1)[0];
          currentReading.push(selectedCard);
          
          // Renderizar cara frontal
          renderCardFront(i, selectedCard);
        }

        // Voltear cartas gradualmente
        currentReading.forEach((_, idx) => {
          setTimeout(() => {
            document.getElementById(`slot-${idx}`).classList.add("flipped");
          }, idx * 400 + 300);
        });

        // Guardar en historial
        saveHistory(currentReading, currentMode);

        setTimeout(() => {
          drawBtn.disabled = false;
        }, currentMode * 400 + 500);

      }, 400);
    }

    function renderCardFront(slotIdx, card) {
      const frontElem = document.getElementById(`card-front-${slotIdx}`);
      const iconName = ELEMENT_ICONS[card.element] || 'sparkles';

      frontElem.innerHTML = `
        <div class="card-header-art" style="background: linear-gradient(to bottom, rgba(0,0,0,0.2), var(--bg-card)), ${card.color};">
          <div class="card-element-icon">
            <i data-lucide="${iconName}" style="width:16px; height:16px;"></i>
          </div>
          <i data-lucide="${iconName}" style="width:50px; height:50px; color: rgba(226,192,112,0.4);"></i>
        </div>
        <div class="card-number">N° ${card.id} • ${card.element}</div>
        <h3 class="card-title">${card.name}</h3>
        <div class="card-keywords">${card.keywords}</div>
        <p class="card-description">${card.desc}</p>
      `;
      lucide.createIcons();
    }

    function flipSingleCard(idx) {
      const container = document.getElementById(`slot-${idx}`);
      if (currentReading[idx]) {
        container.classList.toggle("flipped");
      }
    }

    /* ===================================================
       5. GALERÍA / COMPENDIO DE CARTAS
       =================================================== */
    function renderCompendium(cardsToRender) {
      const grid = document.getElementById("compendium-grid");
      grid.innerHTML = "";

      cardsToRender.forEach(card => {
        const iconName = ELEMENT_ICONS[card.element] || 'sparkles';
        const item = document.createElement("div");
        item.className = "compendium-item";
        item.onclick = () => openModal(card);
        item.innerHTML = `
          <div class="compendium-thumb" style="background: linear-gradient(135deg, ${card.color}, var(--bg-dark)); display:flex; align-items:center; justify-content:center;">
            <i data-lucide="${iconName}" style="width:40px; height:40px; color: var(--primary-gold);"></i>
          </div>
          <div class="compendium-title">${card.name}</div>
          <div class="compendium-element">N° ${card.id} • Elemento ${card.element}</div>
        `;
        grid.appendChild(item);
      });
      lucide.createIcons();
    }

    function setupCompendiumFilters() {
      const searchInput = document.getElementById("search-card");
      const filterBtns = document.querySelectorAll(".filter-btn");

      let currentElement = "all";

      const applyFilters = () => {
        const query = searchInput.value.toLowerCase();
        const filtered = CARDS.filter(card => {
          const matchesSearch = card.name.toLowerCase().includes(query) || 
                                card.keywords.toLowerCase().includes(query) ||
                                card.desc.toLowerCase().includes(query);
          const matchesElement = currentElement === "all" || card.element === currentElement;
          return matchesSearch && matchesElement;
        });
        renderCompendium(filtered);
      };

      searchInput.addEventListener("input", applyFilters);

      filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          currentElement = btn.dataset.filter;
          applyFilters();
        });
      });
    }

    /* ===================================================
       6. HISTORIAL DE LECTURAS
       =================================================== */
    function saveHistory(cards, mode) {
      const readingRecord = {
        date: new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: 'short' }),
        mode: mode === 1 ? "Carta Única" : "Tirada de 3 Cartas",
        cards: [...cards]
      };
      history.unshift(readingRecord);
      renderHistory();
    }

    function renderHistory() {
      const list = document.getElementById("history-list");
      if (history.length === 0) {
        list.innerHTML = `<p style="text-align:center; color: var(--text-muted); padding: 2rem;">Aún no has realizado ninguna lectura en esta sesión.</p>`;
        return;
      }

      list.innerHTML = "";
      history.forEach(item => {
        const cardElem = document.createElement("div");
        cardElem.className = "history-card";
        
        let cardsHTML = item.cards.map(c => `
          <div class="history-card-mini">
            <strong style="color:var(--primary-gold); font-size:0.9rem;">${c.name}</strong>
            <p style="font-size:0.75rem; color:var(--text-muted); margin-top:4px;">${c.element}</p>
          </div>
        `).join('');

        cardElem.innerHTML = `
          <div class="history-header">
            <span class="history-type">${item.mode}</span>
            <span class="history-date">${item.date}</span>
          </div>
          <div class="history-cards-flex">${cardsHTML}</div>
        `;
        list.appendChild(cardElem);
      });
    }

    /* ===================================================
       7. MODAL DE DETALLES DE CARTA
       =================================================== */
    function setupModal() {
      const modal = document.getElementById("card-modal");
      const closeBtn = document.getElementById("modal-close-btn");

      closeBtn.addEventListener("click", () => {
        modal.classList.remove("active");
      });

      modal.addEventListener("click", (e) => {
        if (e.target === modal) modal.classList.remove("active");
      });
    }

    function openModal(card) {
      const modal = document.getElementById("card-modal");
      const body = document.getElementById("modal-body");
      const iconName = ELEMENT_ICONS[card.element] || 'sparkles';

      body.innerHTML = `
        <div style="text-align:center; margin-bottom: 1.5rem;">
          <div style="width:70px; height:70px; margin: 0 auto 1rem; border-radius:50%; background:${card.color}; border:2px solid var(--primary-gold); display:flex; align-items:center; justify-content:center; color:var(--primary-gold);">
            <i data-lucide="${iconName}" style="width:36px; height:36px;"></i>
          </div>
          <span style="font-family:'Montserrat', sans-serif; font-size:0.8rem; color:var(--text-muted); letter-spacing:2px;">CARTA N° ${card.id} • ELEMENTO ${card.element.toUpperCase()}</span>
          <h2 style="font-family:'Cinzel Decorative', cursive; color:var(--primary-gold); margin: 0.5rem 0;">${card.name}</h2>
          <p style="font-family:'Montserrat', sans-serif; color:var(--terracotta); font-size:0.9rem; font-weight:500;">${card.keywords}</p>
        </div>
        <hr style="border:none; border-top:1px solid rgba(226,192,112,0.2); margin: 1rem 0;">
        <p style="font-size:1.1rem; line-height:1.6; color:var(--text-light); text-align:justify;">${card.desc}</p>
      `;
      lucide.createIcons();
      modal.classList.add("active");
    }
  </script>
</body>
